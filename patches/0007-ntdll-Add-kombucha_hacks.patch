From 0c0ae25776b556e65403bc6d6f9423d2b605db39 Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Sun, 27 Sep 2026 15:13:50 +0200
Subject: [PATCH 07/17] ntdll: Add kombucha_hacks

---
 dlls/ntdll/unix/loader.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index dde4b58..2e3f560 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1822,6 +1822,12 @@ static ULONG_PTR get_image_address(void)
     return 0;
 }
 
+static void kombucha_hacks(void)
+{
+    // Fixes versions of Roblox Studio shipping mimalloc from crashing
+    setenv("MIMALLOC_FORCE_REDIRECT", "1", 0 );
+}
+
 /***********************************************************************
  *           start_main_thread
  */
@@ -1830,6 +1836,7 @@ static void start_main_thread(void)
     struct thread_data *data = virtual_alloc_first_thread_data();
 
     server_init_process( data );
+    kombucha_hacks();
     virtual_map_user_shared_data();
     init_cpu_info();
     init_files();
-- 
