From 9c90a515a862640daaa79da094f69400435b47b8 Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Wed, 26 Aug 2026 20:35:21 +0200
Subject: [PATCH 02/10] wine.inf: Add KombuchaOverrides

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 loader/wine.inf.in | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 8d229aa7a51..1ee588c2572 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -63,6 +63,7 @@ AddReg=\
     Debugger,\
     DirectX,\
     Fonts,\
+    KombuchaOverrides,\
     LicenseInformation,\
     MCI,\
     Misc,\
@@ -1458,3 +1459,29 @@ HKLM,Software\Microsoft\Speech_OneCore\Voices\Tokens\ProtonTTS_libritts-r_14\Att
 HKLM,Software\Microsoft\Speech_OneCore\Voices\Tokens\ProtonTTS_libritts-r_14\Attributes,"Gender",,"Female"
 HKLM,Software\Microsoft\Speech_OneCore\Voices\Tokens\ProtonTTS_libritts-r_14\Attributes,"Age",,"Adult"
 HKLM,Software\Microsoft\Speech_OneCore\Voices\Tokens\ProtonTTS_libritts-r_14\Attributes,"Vendor",,"Wine"
+
+[KombuchaOverrides]
+; Prefer loading native msvcrt DLLs that are bundled with Studio and WebView2 for better compatibility with Wine.
+; DLLs starting with 'api-ms-win-' cannot be overridden (?).
+; Upstream Wine refuses to load native ucrtbase, unless it's copied over to the Wineprefix. The downstream fork of Wine used in Proton includes a patch that addresses this.
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-conio-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-heap-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-locale-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-math-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-runtime-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-stdio-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"api-ms-win-crt-time-l1-1-0",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"concrt140",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"msvcp140",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"msvcp140_1",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"msvcp140_2",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"msvcp140_codecvt_ids",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"ucrtbase",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"vccorlib140",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"vcruntime140",0x2,"native,builtin"
+HKCU,Software\Wine\DllOverrides,"vcruntime140_1",0x2,"native,builtin"
+; WebView2 requires DirectComposition on Windows versions >=8.1, which Wine doesn't support, so spoof the Windows version to 8.
+; As of 2026-08-26, the dcomp-DCompositionCreateDevice2 patchset in Wine Staging causes WebView2 to always flicker when the Creator Store tab isn't selected.
+HKCU,Software\Wine\AppDefaults\msedgewebview2.exe,"Version",0x2,"win8"
+; WebView2 uses Arial as its font, which is proprietary and doesn't come with most Linux distributions, so force it to use Liberation Sans.
+HKCU,Software\Wine\Fonts\Replacements,"Arial",0x2,"Liberation Sans"
-- 
