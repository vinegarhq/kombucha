From 751432481563cbf0cfb7afd0d0ed051e72e4c90a Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Sun, 30 Aug 2026 16:57:40 +0200
Subject: [PATCH 08/13] server: Add environment variable for forcing
 persistence to 0 seconds

Opt-in workaround for https://github.com/vinegarhq/vinegar/issues/779.

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 server/main.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/server/main.c b/server/main.c
index 46419a09cb4..40bf137fa85 100644
--- a/server/main.c
+++ b/server/main.c
@@ -44,7 +44,7 @@
 /* command-line options */
 int debug_level = 0;
 int foreground = 0;
-timeout_t master_socket_timeout = 3 * -TICKS_PER_SEC;  /* master socket timeout, default is 3 seconds */
+timeout_t master_socket_timeout = 0;  /* master socket timeout, default is 3 seconds */
 const char *server_argv0;
 
 /* parse-line args */
@@ -90,7 +90,11 @@ static void option_callback( int optc, char *optarg )
         exit( !ret );
     case 'p':
         if (optarg && isdigit(*optarg))
-            master_socket_timeout = (timeout_t)atoi( optarg ) * -TICKS_PER_SEC;
+            if (getenv("WINESERVER_NO_PERSISTENT")) {
+                master_socket_timeout = (timeout_t)atoi( 0 );
+            } else {
+                master_socket_timeout = (timeout_t)atoi( optarg ) * -TICKS_PER_SEC;
+            }
         else
             master_socket_timeout = TIMEOUT_INFINITE;
         break;
-- 
