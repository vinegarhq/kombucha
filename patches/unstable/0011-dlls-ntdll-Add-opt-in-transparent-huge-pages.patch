From bf20d45af6e3dce6e297c8a80ea519a4e70f960c Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Fri, 14 Aug 2026 22:50:19 +0200
Subject: [PATCH 11/12] dlls/ntdll: Add opt-in transparent huge pages

Source: https://github.com/bottlesdevs/wine/commit/69d56ca
Signed-off-by: effects3d <effects3dee@gmail.com>
---
 dlls/ntdll/unix/virtual.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index db820a8..29caa39 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -240,6 +240,9 @@ static void *preload_reserve_start;
 static void *preload_reserve_end;
 static BOOL force_exec_prot;  /* whether to force PROT_EXEC on all PROT_READ mmaps */
 static BOOL enable_write_exceptions;  /* raise exception on writes to executable memory */
+#ifdef MADV_HUGEPAGE
+static BOOL use_transparent_huge_pages;
+#endif
 
 struct range_entry
 {
@@ -3685,6 +3688,10 @@ void virtual_init(void)
 
     kernel_writewatch_init();
 
+#ifdef MADV_HUGEPAGE
+    if ((preload = getenv( "KOMBUCHA_USE_THP" ))) use_transparent_huge_pages = !strcmp( preload, "1" );
+#endif
+
     if (preload_info && *preload_info)
         for (i = 0; (*preload_info)[i].size; i++)
             mmap_add_reserved_area( (*preload_info)[i].addr, (*preload_info)[i].size );
@@ -5190,6 +5197,11 @@ static NTSTATUS allocate_virtual_memory( void **ret, SIZE_T *size_ptr, ULONG typ
             if (status == STATUS_SUCCESS)
             {
                 base = view->base;
+#ifdef MADV_HUGEPAGE
+                if (use_transparent_huge_pages && is_view_valloc( view ) &&
+                    !(view->protect & (VPROT_WRITEWATCH | VPROT_PLACEHOLDER)))
+                    madvise( view->base, view->size, MADV_HUGEPAGE );
+#endif
                 if (vprot & VPROT_EXEC || force_exec_prot) mprotect_range( base, size, 0, 0 );
             }
         }
