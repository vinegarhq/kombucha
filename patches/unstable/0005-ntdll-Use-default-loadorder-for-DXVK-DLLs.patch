Subject: [PATCH 05/19] ntdll: Use default loadorder for DXVK DLLs

Fixes https://github.com/vinegarhq/vinegar/issues/871.

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 dlls/ntdll/unix/loadorder.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/ntdll/unix/loadorder.c b/dlls/ntdll/unix/loadorder.c
index 54d485a..c3a4d52 100644
--- a/dlls/ntdll/unix/loadorder.c
+++ b/dlls/ntdll/unix/loadorder.c
@@ -429,6 +429,7 @@ static enum loadorder version_heuristics( const UNICODE_STRING *nt_name,
     static const struct { WCHAR name[32]; enum loadorder lo; } vendors[] =
     {
         { {'M','i','c','r','o','s','o','f','t',0}, LO_DEFAULT },
+        { {'D','X','V','K',0}, LO_DEFAULT },
         { {'T','w','a','i','n',' ','W','o','r','k','i','n','g',' ','G','r','o','u','p',0}, LO_BUILTIN },
         { {0}, LO_NATIVE_BUILTIN }
     };
