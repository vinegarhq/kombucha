From c69925abe609fbde9085915985e7ffe892af0bb0 Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Sun, 13 Sep 2026 13:46:13 +0200
Subject: [PATCH 06/11] server: Force persistence to 0 seconds

Temporary workaround for
https://github.com/vinegarhq/vinegar/issues/779.

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 server/main.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/server/main.c b/server/main.c
index 7f6912bc01b..ca3f95a9675 100644
--- a/server/main.c
+++ b/server/main.c
@@ -93,7 +93,11 @@ static void option_callback( int optc, char *optarg )
         exit( !ret );
     case 'p':
         if (optarg && isdigit(*optarg))
-            master_socket_timeout = (timeout_t)atoi( optarg ) * -TICKS_PER_SEC;
+            if (getenv("WINESERVER_PERSISTENT")) {
+                master_socket_timeout = (timeout_t)atoi( optarg ) * -TICKS_PER_SEC;
+            } else {
+                master_socket_timeout = (timeout_t)atoi( 0 );
+            }
         else
             master_socket_timeout = TIMEOUT_INFINITE;
         break;
-- 
