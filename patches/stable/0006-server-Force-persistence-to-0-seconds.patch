From 5b7b16787f34a86b03a9d36e7acacf1f03dadd56 Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Sun, 27 Sep 2026 14:58:08 +0200
Subject: [PATCH 06/18] server: Force persistence to 0 seconds

Workaround for https://github.com/vinegarhq/vinegar/issues/779.

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 server/main.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/server/main.c b/server/main.c
index 46419a0..a90919a 100644
--- a/server/main.c
+++ b/server/main.c
@@ -44,7 +44,7 @@
 /* command-line options */
 int debug_level = 0;
 int foreground = 0;
-timeout_t master_socket_timeout = 3 * -TICKS_PER_SEC;  /* master socket timeout, default is 3 seconds */
+timeout_t master_socket_timeout = 0;  /* master socket timeout, default is 3 seconds */
 const char *server_argv0;
 
 /* parse-line args */
@@ -89,10 +89,7 @@ static void option_callback( int optc, char *optarg )
             ret = kill_lock_owner(-1);
         exit( !ret );
     case 'p':
-        if (optarg && isdigit(*optarg))
-            master_socket_timeout = (timeout_t)atoi( optarg ) * -TICKS_PER_SEC;
-        else
-            master_socket_timeout = TIMEOUT_INFINITE;
+        master_socket_timeout = 0;
         break;
     case 'v':
         fprintf( stderr, "%s\n", PACKAGE_STRING );
-- 
