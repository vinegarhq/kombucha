Subject: [PATCH 14/18] winewayland: Add warning regarding experimental status

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 dlls/winewayland.drv/wayland.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index 52ba39c..1afee1a 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -24,6 +24,8 @@
 
 #include "config.h"
 
+#include <stdio.h>
+
 #include "waylanddrv.h"
 
 #include "wine/debug.h"
@@ -312,6 +314,8 @@ BOOL wayland_process_init(void)
         return FALSE;
     }
 
+    fprintf( stderr, "kombucha: studio under winewayland is experimental, please use winex11 instead!\n" );
+
     wayland_window_init();
 
     /* Populate registry */
