Subject: [PATCH 10/14] explorer: Enable virtual desktop shell by default

Signed-off-by: effects3d <effects3dee@gmail.com>
---
 programs/explorer/desktop.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
index ce70c5dd79d..3544f6b1fbc 100644
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -928,7 +928,7 @@ static BOOL get_default_enable_shell( const WCHAR *name )
         RegCloseKey( hkey );
     }
     /* Default off, except for the magic desktop name "shell" */
-    if (!found) result = (lstrcmpiW( name, L"shell" ) == 0);
+    if (!found) result = TRUE;
     return result;
 }
 
