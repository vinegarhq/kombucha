From cb0c0c1bcff239614c2b713825e11e01f13a6070 Mon Sep 17 00:00:00 2001
From: effects3d <effects3dee@gmail.com>
Date: Sun, 30 Aug 2026 22:08:32 +0200
Subject: [PATCH 06/17] explorer: Enable virtual desktop shell by default

This should make managing multiple instances of Roblox Studio in virtual
desktop mode more convenient.
---
 programs/explorer/desktop.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
index 4f52b93..be4ce34 100644
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -928,7 +928,7 @@ static BOOL get_default_enable_shell( const WCHAR *name )
         RegCloseKey( hkey );
     }
     /* Default off, except for the magic desktop name "shell" */
-    if (!found) result = (lstrcmpiW( name, L"shell" ) == 0);
+    if (!found) result = TRUE;
     return result;
 }
 
